# данные и выданные организаторами материалы — только локально (якорь / — чтобы не задеть service/data)
/data/
/baseline/
/out/
# отправки на лидерборд: RLE-файлы по 10+ МБ, воспроизводятся командой inference.py
/submissions/*.csv
# кроме сданного финального файла: организаторы видят его рядом с кодом (3 МБ)
!/submissions/submission_v5_final.csv

# растровые/векторные тяжёлые артефакты
*.tif
*.tiff
*.tar
*.zip
service/data/*.gpkg
service/data/cache/

# веса: маленькие коммитим, большие (>50 МБ) — по ссылке из README
weights/*.pt
weights/*.pth
weights/*.ckpt
!weights/.gitkeep

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv_*/
venv/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
*.log

# артефакты скриншотов (playwright)
.playwright-mcp/

# EDA: кэш признаков пересчитывается скриптами eda/*.py
eda/cache/

# временные lock-файлы MS Office (презентация открыта в PowerPoint)
~$*

# каталоги весов экспериментов BS (в git не входят, воспроизводятся train.py --weights-dir)
/weights_repro/
/weights_lovasz/
/weights_lovasz_pure/
/weights_night_*/
/weights_ms_check/

# репозиторий = код + документация к коду; презентация, пакет защиты, журналы задач, ТЗ организаторов и PDF
# живут в отдельном пакете артефактов (вне git) — чтобы случайно не вернулись:
/presentation/
/handoff/
/prompts/
/docs/
/artifacts/
/reports/tasklog/
*.pdf
*.pptx
*.rar
*.mp4
*.webm

# вырезки примеров BS нужны только слайдам (пакет артефактов); строит scripts/make_report_figures.py
reports/figures/bs_case_*.png
